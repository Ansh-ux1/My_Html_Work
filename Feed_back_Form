<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>

    <style>
        * {
            padding: 0;
            margin: 0;
        }

        #Main_Box {
            height: 500px;
            background-color: rgb(180, 255, 230);
            width: 600px;
            border: 2px solid black;
            margin-left: 450px;
            border-radius: 20px;
        }

        label {
            font-family: Arial;
            font-weight: 600;
            font-size: 20px;
            display: block;
            margin-top: 20px;
            margin-left: 30px;
        }

        h1 {
            font-size: 30;
            font-family: Arial;
            margin-left: 170px;
            margin-top: 40px;
        }

        input {
            font-size: 20px;
            width: 500px;
            height: 45px;
            margin-left: 30px;
            margin-top: 10px;
        }

        #rating {
            /* background-color: rgb(243, 248, 248); */
            height: 50px;
            width: 550px;
            font-family: Arial, Helvetica, sans-serif;
            border-radius: 10px;
            display: flex;
            align-items: center;

        }

        #rating input {
            height: 20px;
        }
        button{
            height: 40px;
            width:120px;
            font-size: 20px;
            border-radius: 10px;
            margin-left: 30px;
            margin-top: 40px;
            background-color: rgb(121, 228, 255);
            color: white;

        }
    </style>
</head>

<body>
    <div id="Main_Box">
        <h1>Feed_Back_Form</h1>
        <label>Full Name</label>
        <input type="text" placeholder="Enter Your Name ">

        <label>Email</label>
        <input type="text" placeholder="Enter Your Email">

        <label>Rating</label>
        <div id="rating">
            <input type="radio" name="rating"> 1_Star
            <input type="radio" name="rating"> 2_Star
            <input type="radio" name="rating"> 3_Star
            <input type="radio" name="rating"> 4_Star
            <input type="radio" name="rating"> 5_Star
        </div>
        <button>Submit</button>
    </div>

</body>

</html>
